<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Isolator.Mxc</Title>
    <Authors>Ricardo Peres</Authors>
    <PackageProjectUrl>https://github.com/rjperes/Isolator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rjperes/Isolator</RepositoryUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Mxc.Sdk" Version="1.0.1" />
    <ProjectReference Include="..\Isolator\Isolator.csproj" />
  </ItemGroup>

</Project>
